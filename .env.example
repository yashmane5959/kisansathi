# Google Gemini API Key (Get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Open Government Data India API Key (Get from https://data.gov.in)
DATA_GOV_API_KEY=your_data_gov_api_key_here

# Telegram Bot Token from @BotFather (optional)
TELEGRAM_BOT_TOKEN=

# Default language for proactive weather & farming alerts
ALERT_LANGUAGE=Hindi

# Database & Scheduler Config
DATABASE_URL=sqlite:///./kisansathi.db
APP_TIMEZONE=Asia/Kolkata
MORNING_HOUR=6
MORNING_MINUTE=30
RUN_SCHEDULER=true
RUN_BOT_IN_APP=false
