# ==============================================================================
# KisanSathi Environment Configuration Template
# Copy this file to .env and provide your actual API keys and tokens.
# DO NOT commit the .env file to version control.
# ==============================================================================

# Google Gemini API Key (Get free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (e.g. gemini-3.5-flash, gemini-3.8-flash, gemini-2.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Open Government Data (data.gov.in) API Key (Register free at https://data.gov.in)
DATA_GOV_API_KEY=your_data_gov_api_key_here

# Telegram Bot Token from @BotFather (Optional: required only for running the Telegram bot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Default language for proactive weather and farm alerts (e.g. Hindi, Marathi, English)
ALERT_LANGUAGE=Hindi

# Port for FastAPI web server (Render sets this dynamically, default is 8000)
PORT=8000
